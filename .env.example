# İlk yerel kurulum için örnek değerler.
# JWT_SECRET boş bırakılırsa data/.jwt-secret içinde güvenli bir anahtar üretilir.
# ADMIN_PASSWORD boş bırakılırsa ilk açılışta rastgele bir parola üretilir ve data/.admin-initial-password dosyasına yazılır.
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
PORT=3000
SEED_DEMO_DATA=false
FOOTBALL_V2_BETA_LOBBY=true
